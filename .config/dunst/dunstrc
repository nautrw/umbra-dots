[global]
    ### Display ###

    monitor = 1
    follow = none

    ### Geometry ###

    width = 360
    height = (0, 300)
    origin = top-right
    offset = (12, 12)
    scale = 0
    notification_limit = 10

    ### Progress bar ###

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 360
    progress_bar_corner_radius = 2
    progress_bar_corners = all

    ### Appearance ###

    icon_corner_radius = 0
    icon_corners = all

    indicate_hidden = yes
    transparency = 0

    separator_height = 1
    separator_color = "#454545"

    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10

    frame_width = 1
    frame_color = "#454545"
    gap_size = 8

    ### Text ###

    font = "sans 12"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no

    ### Notification behavior ###

    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_posix_regex = false

    ### Icons ###

    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    ### History ###

    sticky_history = yes
    history_length = 20

    ### Miscellaneous ###

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true

    title = Dunst
    class = Dunst

    corner_radius = 12
    corners = all

    ignore_dbusclose = false

    ### Wayland ###

    force_xwayland = false

    ### Legacy ###

    force_xinerama = false

    ### Mouse ###

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all


[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false
    enable_pcre_regex = false


### Low urgency ###

[urgency_low]
    background = "#242424"
    foreground = "#c0bfbc"
    frame_color = "#454545"
    highlight = "#78aeed"
    timeout = 5
    default_icon = dialog-information


### Normal urgency ###

[urgency_normal]
    background = "#303030"
    foreground = "#ffffff"
    frame_color = "#454545"
    highlight = "#78aeed"
    timeout = 8
    override_pause_level = 30
    default_icon = dialog-information


### Critical urgency ###

[urgency_critical]
    background = "#303030"
    foreground = "#ffffff"
    frame_color = "#ed333b"
    highlight = "#ed333b"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
