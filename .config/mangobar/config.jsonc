// mangobar config (JSONC).
{
    "layer": "top",
    "height": 27,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,
    // "sys-interval": 2,  // default refresh interval (seconds) for polled modules

    "modules-left": [
        "workspaces",
        // "layout",
    ],
    "modules-center": [
        "window"
    ],
    "modules-right": [
        "hideclients",
        "tray",
        // "network",
        // "keymode",
        // "keyboardlayout",
        "cpu",
        "memory",
        "pulseaudio",
        // "backlight",
        "battery",
        "clock#date",
        "clock#time",
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4, 5, 6, 7, 8, 9],
        // "tag-names": ["1", "2", "3", "编", "网"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        "max-length": 600,
        "on-click": "bash ~/.config/mango/scripts/screenshot.sh",
        "on-click-right": "python /home/wrq/tool/ocr.py"
    },

    "network": {
        // Placeholders: {ifname}/{} interface, {ipaddr}/{ip} IPv4 address,
        // {ssid}/{essid}, {signal} icon, {strength}/{signal-percent} percent,
        // {status}, {type}, {icon}, {down}/{up} (speed in format-alt)
        "format": "{icon} {ifname}",
        "format-wifi": "{signal} {ssid}",
        "format-disconnected": "{icon}",
        "icon-wifi": "󰖩",
        "icon-ethernet": "󰈀",
        "icon-disconnected": "󰖪",
        "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-alt": "↓{down} ↑{up}",
        // "interval": 1  // seconds; omit to use the global "sys-interval"
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": "  {load}%",
        // "interval": 1  // seconds; omit to use the global "sys-interval"
    },
    "memory": {
        "format": " {}%",
        // "interval": 5  // seconds; omit to use the global "sys-interval"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟"],
        "on-scroll-up": "bash ~/.config/mango/scripts/brightness.sh bup",
        "on-scroll-down": "bash ~/.config/mango/scripts/brightness.sh bdown",
        "on-click": "brightnessctl set 1%"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}% {bt}",
        "format-muted": "󰝟  {volume}% {bt}",
        "icons": ["󰝟", "󰕿", "󰕾"],
        // "icon-bluetooth": "󰂯",
        "on-click": "pavucontrol",
        "on-scroll-up": "pamixer -i 2",
        "on-scroll-down": "pamixer -d 2"
    },
    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        // "icon-charging": "󰂄",
        // "icon-full": "󰁹",
        // "icon-ac": "",
        // "hide-on-ac": true
    },
    "clock#date": {
        "format": "  {:L%m/%d/%Y}"
    },
    "clock#time": {
        "format": "  {:L%H:%M}"
    },
    "tray": {
        "icon-size": 25,
        "spacing": 10
    },
}
